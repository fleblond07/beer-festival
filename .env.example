POSTGRES_DB=<required-database-name>
POSTGRES_USER=<required-database-user>
POSTGRES_PASSWORD=<required-strong-database-password>
DATABASE_URL=postgres://<required-database-user>:<required-strong-database-password>@localhost:5432/<required-database-name>?sslmode=disable
JWT_SECRET=<required-long-random-jwt-secret>
ADMIN_EMAIL=<optional-admin-email>
ADMIN_PASSWORD=<optional-admin-password>
SUPABASE_DATABASE_URL=postgres://postgres:<required-supabase-password>@db.<required-project-ref>.supabase.co:5432/postgres?sslmode=require
