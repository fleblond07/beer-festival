POSTGRES_DB=<required-database-name>
POSTGRES_USER=<required-database-user>
POSTGRES_PASSWORD=<required-strong-database-password>
# DATABASE_URL: password must be percent-encoded if it contains special characters (POSTGRES_PASSWORD above stays raw).
DATABASE_URL=postgres://<required-database-user>:<url-encoded-database-password>@localhost:5432/<required-database-name>?sslmode=disable
# JWT_SECRET is required; leave empty and set a real long random value before starting the app.
JWT_SECRET=
# ADMIN_EMAIL and ADMIN_PASSWORD are optional. Leave both empty to skip creating an admin user;
# set both explicitly to have Docker create/update the admin account on first init.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SUPABASE_DATABASE_URL: password must be percent-encoded if it contains special characters.
SUPABASE_DATABASE_URL=postgres://postgres:<url-encoded-supabase-password>@db.<required-project-ref>.supabase.co:5432/postgres?sslmode=require
